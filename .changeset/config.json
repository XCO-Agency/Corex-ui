{
  "$schema": "https://unpkg.com/@changesets/config@4.0.1/schema.json",
  "changelog": [
    "@changesets/changelog-github",
    {
      "repo": "XCO-Agency/Corex-ui"
    }
  ],
  "commit": false,
  "fixed": [],
  "linked": [],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": ["playground"],
  "privatePackages": {
    "version": false,
    "tag": false
  },
  "changedFilePatterns": [
    "src/**",
    "scripts/**",
    "package.json",
    "tsup.config.ts",
    "tsconfig.json"
  ],
  "format": "prettier",
  "bumpVersionsWithWorkspaceProtocolOnly": true
}
