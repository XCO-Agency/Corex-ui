{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "corex-ui",
  "main": "./worker/index.ts",
  "compatibility_date": "2024-09-23",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
}
