{
  "name": "corex-ui-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.30.3",
  "description": "Workspace root for @xco-agency/corex-ui, a Polaris-web-component-backed, legacy-Polaris-React-compatible UI library for Shopify apps.",
  "scripts": {
    "build": "pnpm --filter @xco-agency/corex-ui run build",
    "build:playground": "pnpm --filter playground run build",
    "dev": "pnpm --filter playground run dev",
    "test": "pnpm --filter @xco-agency/corex-ui run test",
    "typecheck": "pnpm --filter @xco-agency/corex-ui run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
